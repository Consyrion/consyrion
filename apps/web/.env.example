# Copy to .env.local (this folder) for local development. Never commit real values.

# Self-hosted installation: no plans or limits, the billing page only explains BYOK. Leave empty only when you run
# CONSYRION AI as a hosted service with plans (docs/saas.md).
SELF_HOSTED=true

# Database: leave empty to use the embedded PGlite database in ./.data/pglite (development only).
# Production: a PostgreSQL connection string, e.g. postgres://user:pass@host:5432/consyrion
DATABASE_URL=

# Better Auth: generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Social login (optional; email/password always works). Buttons appear only when both values are set.
# Google: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#   Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Master key for encrypting stored provider API keys (BYOK).
# 32 random bytes, base64: `openssl rand -base64 32`. Rotate by adding a new version (see docs/security/credentials.md).
CREDENTIALS_MASTER_KEY_V1=
CREDENTIALS_ACTIVE_KEY_VERSION=1

# GitHub App (Milestone 5, optional). See docs/github-app.md for the required permissions and URLs.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# PEM private key; newlines may be written as \n on one line
GITHUB_APP_PRIVATE_KEY=

# Platform administration: comma-separated e-mail addresses with access to /admin
PLATFORM_ADMIN_EMAILS=

# Stripe (Milestone 6, optional) – platform subscription only; Consyrion never bills AI usage (BYOK).
# Without these values online checkout is disabled and plans are assigned by the platform admin.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Model strength ranking (#139, optional) – the platform's own free key from artificialanalysis.ai (1,000 requests/day,
# attribution required). Not a model key: it only reads public ranking data. Without it every model is "unknown" (tier 5).
ARTIFICIAL_ANALYSIS_API_KEY=

# E-mail delivery of decisions (#165, optional) – an SMTP server of the operator, e.g. the consyrion.com mailbox.
# smtp://user:pass@host:587 (STARTTLS; use this on Hetzner, which blocks 25/465) or smtps://user:pass@host:465.
# Only workspace members can be recipients. Without SMTP_URL "Send to … e-mail" shows "not configured".
SMTP_URL=
MAIL_FROM="CONSYRION AI <no-reply@consyrion.com>"

# E-mail verification of new password accounts is on whenever SMTP_URL is set: sign-in needs the link from the
# confirmation e-mail, and platform admins need a verified address. Set to false only to switch it off on purpose.
REQUIRE_EMAIL_VERIFICATION=

# Feedback inbox (#295, optional): comma-separated addresses that get an e-mail about every new bug report, feature
# wish or contact message (needs SMTP_URL). Without it reports are only in /admin/feedback.
ADMIN_EMAILS=
