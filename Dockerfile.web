# Web app (Next.js standalone). Build: docker build -f Dockerfile.web -t consyrion-web .
FROM node:24-alpine AS build
WORKDIR /app
RUN corepack enable pnpm
COPY . .
# The build traces public/ into the standalone bundle; it is copied into the image once below, so the traced copy is
# dropped here (otherwise e.g. the 8 MB CJK font of Chinese PDFs, #268, would sit in two layers).
# The Obsidian plugin is built first and served from /downloads/obsidian (setup page /integrations/obsidian).
RUN pnpm install --frozen-lockfile && pnpm --filter consyrium-obsidian build \
  && mkdir -p apps/web/public/downloads/obsidian && cp apps/obsidian/dist/main.js apps/obsidian/dist/manifest.json apps/web/public/downloads/obsidian/ \
  && pnpm --filter @consyrium/web build && rm -rf apps/web/.next/standalone/apps/web/public

FROM node:24-alpine AS runtime
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 COUNCIL_WORKER=external
WORKDIR /app
RUN addgroup -S app && adduser -S app -G app
COPY --from=build --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=build --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=app:app /app/apps/web/public ./apps/web/public
COPY --from=build --chown=app:app /app/packages/db/drizzle ./packages/db/drizzle
USER app
WORKDIR /app/apps/web
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://127.0.0.1:3000/api/health || exit 1
CMD ["node", "server.js"]
