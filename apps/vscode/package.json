{
  "name": "consyrium",
  "displayName": "CONSYRIUM AI",
  "description": "Follow CONSYRIUM AI council decisions, approve verdicts and review generated code inside VS Code.",
  "version": "0.1.0",
  "publisher": "consyrium",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": { "type": "git", "url": "https://github.com/Consyrion/consyrium" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "capabilities": {
    "untrustedWorkspaces": { "supported": true, "description": "Only talks to your CONSYRIUM AI server; it never runs code from the workspace." },
    "virtualWorkspaces": true
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [{ "id": "consyrium", "title": "CONSYRIUM AI", "icon": "media/icon.svg" }]
    },
    "views": {
      "consyrium": [{ "id": "consyrium.projects", "name": "Projects & decisions" }]
    },
    "viewsWelcome": [
      { "view": "consyrium.projects", "contents": "Connect to CONSYRIUM AI with a personal API token (CONSYRIUM AI → Settings → API tokens).\n[Sign in](command:consyrium.signIn)" }
    ],
    "commands": [
      { "command": "consyrium.signIn", "title": "CONSYRIUM AI: Sign in with API token" },
      { "command": "consyrium.signOut", "title": "CONSYRIUM AI: Sign out" },
      { "command": "consyrium.refresh", "title": "CONSYRIUM AI: Refresh", "icon": "$(refresh)" },
      { "command": "consyrium.openSession", "title": "CONSYRIUM AI: Open decision" },
      { "command": "consyrium.openChanges", "title": "CONSYRIUM AI: Open generated changes" }
    ],
    "menus": {
      "view/title": [{ "command": "consyrium.refresh", "when": "view == consyrium.projects", "group": "navigation" }]
    },
    "configuration": {
      "title": "CONSYRIUM AI",
      "properties": {
        "consyrium.language": { "type": "string", "enum": ["auto", "en", "de", "fr", "es"], "default": "auto", "description": "Language of the extension; auto follows the VS Code display language." },
        "consyrium.serverUrl": { "type": "string", "default": "https://app.consyrium.com", "description": "Base URL of your CONSYRIUM AI server (hosted: https://app.consyrium.com, or your self-hosted address)." }
      }
    }
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=dist/extension.js --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "package": "pnpm build && vsce package --no-dependencies --out dist/consyrium.vsix"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2"
  }
}
