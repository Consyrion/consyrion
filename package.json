{
  "name": "consyrion",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @consyrion/web dev",
    "build": "pnpm --filter @consyrion/web build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @consyrion/db generate",
    "db:migrate": "pnpm --filter @consyrion/db migrate",
    "format": "prettier --write",
    "format:check": "prettier --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.13.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "protobufjs",
      "@google/genai"
    ]
  }
}
